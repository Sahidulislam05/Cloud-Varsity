
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Password Reset - CloudVarsity</title>

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;

      background: #f3f6fb;

      color: #1e293b;

      font-family:
        "Inter",
        Arial,
        Helvetica,
        sans-serif;
    }

    table {
      border-spacing: 0;
    }

    .email-wrapper {
      width: 100%;
      padding: 45px 15px;

      background:
        radial-gradient(
          circle at top left,
          rgba(37, 99, 235, 0.15),
          transparent 34%
        ),
        radial-gradient(
          circle at bottom right,
          rgba(124, 58, 237, 0.14),
          transparent 34%
        ),
        #f3f6fb;
    }

    .email-container {
      width: 100%;
      max-width: 620px;

      margin: 0 auto;
      overflow: hidden;

      background: #ffffff;

      border-radius: 24px;

      box-shadow:
        0 25px 65px rgba(15, 23, 42, 0.11),
        0 8px 24px rgba(37, 99, 235, 0.07);
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      position: relative;
      overflow: hidden;

      padding: 46px 40px 56px;

      text-align: center;

      background:
        radial-gradient(
          circle at 8% 12%,
          rgba(255, 255, 255, 0.24),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 80%,
          rgba(255, 255, 255, 0.13),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #1d4ed8 0%,
          #2563eb 45%,
          #7c3aed 100%
        );
    }

    .hero::before {
      content: "";

      position: absolute;

      width: 170px;
      height: 170px;

      left: -85px;
      bottom: -85px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.07);
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 210px;
      height: 210px;

      right: -105px;
      top: -105px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.08);
    }

    /* =========================
       UNIVERSITY ICON
    ========================== */

    .icon-wrapper {
      position: relative;
      z-index: 2;

      width: 86px;
      height: 86px;

      margin: 0 auto 22px;

      padding: 7px;

      border-radius: 22px;

      background: rgba(255, 255, 255, 0.16);

      border: 1px solid rgba(255, 255, 255, 0.28);

      box-shadow:
        0 15px 34px rgba(0, 0, 0, 0.13);
    }

    .university-icon {
      width: 72px;
      height: 72px;

      border-radius: 17px;

      background: #ffffff;

      color: #1d4ed8;

      font-size: 32px;

      line-height: 72px;

      text-align: center;
    }

    /* =========================
       HERO TEXT
    ========================== */

    .hero-title {
      position: relative;
      z-index: 2;

      margin: 0;

      color: #ffffff;

      font-size: 29px;

      line-height: 1.3;

      font-weight: 800;

      letter-spacing: -0.6px;
    }

    .hero-subtitle {
      position: relative;
      z-index: 2;

      max-width: 455px;

      margin: 14px auto 0;

      color: rgba(255, 255, 255, 0.88);

      font-size: 14px;

      line-height: 1.75;
    }

    /* =========================
       CONTENT
    ========================== */

    .content {
      padding: 40px;
    }

    .greeting {
      margin: 0 0 10px;

      color: #111827;

      font-size: 18px;

      font-weight: 700;
    }

    .description {
      margin: 0;

      color: #64748b;

      font-size: 14px;

      line-height: 1.85;
    }

    /* =========================
       OTP SECTION
    ========================== */

    .otp-section {
      position: relative;

      margin: 32px 0;

      padding: 30px 20px;

      text-align: center;

      border-radius: 20px;

      background:
        linear-gradient(
          135deg,
          rgba(37, 99, 235, 0.07),
          rgba(124, 58, 237, 0.08)
        );

      border: 1px solid rgba(59, 130, 246, 0.13);

      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .otp-label {
      margin: 0 0 16px;

      color: #64748b;

      font-size: 11px;

      font-weight: 800;

      text-transform: uppercase;

      letter-spacing: 2px;
    }

    .otp {
      display: inline-block;

      padding: 16px 28px;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #1d4ed8,
          #2563eb 50%,
          #7c3aed
        );

      color: #ffffff;

      font-size: 32px;

      font-weight: 800;

      letter-spacing: 9px;

      line-height: 1;

      box-shadow:
        0 12px 28px rgba(37, 99, 235, 0.24);
    }

    .expiration {
      margin: 17px 0 0;

      color: #64748b;

      font-size: 12px;

      line-height: 1.6;
    }

    .expiration strong {
      color: #1d4ed8;
    }

    /* =========================
       RESET STEPS
    ========================== */

    .steps-card {
      margin-top: 28px;

      padding: 23px;

      border-radius: 17px;

      background: #f8fafc;

      border: 1px solid #e2e8f0;
    }

    .steps-title {
      margin: 0 0 16px;

      color: #1e293b;

      font-size: 14px;

      font-weight: 700;
    }

    .step {
      display: table;

      width: 100%;

      margin-bottom: 13px;
    }

    .step:last-child {
      margin-bottom: 0;
    }

    .step-number {
      display: table-cell;

      width: 30px;

      vertical-align: top;
    }

    .step-number span {
      display: inline-block;

      width: 24px;
      height: 24px;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          #1d4ed8,
          #7c3aed
        );

      color: #ffffff;

      font-size: 10px;

      font-weight: 700;

      line-height: 24px;

      text-align: center;
    }

    .step-text {
      display: table-cell;

      vertical-align: top;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;
    }

    /* =========================
       SECURITY
    ========================== */

    .security-box {
      display: table;

      width: 100%;

      margin-top: 25px;

      padding: 18px;

      border-radius: 14px;

      background: #eff6ff;

      border: 1px solid #bfdbfe;
    }

    .security-icon {
      display: table-cell;

      width: 35px;

      vertical-align: top;

      font-size: 18px;
    }

    .security-text {
      display: table-cell;

      vertical-align: top;

      color: #1e40af;

      font-size: 12px;

      line-height: 1.75;
    }

    /* =========================
       UNIVERSITY CTA
    ========================== */

    .cta-section {
      margin-top: 28px;

      padding: 26px 20px;

      text-align: center;

      border-radius: 18px;

      background:
        linear-gradient(
          135deg,
          #eff6ff,
          #f5f3ff
        );

      border: 1px solid rgba(59, 130, 246, 0.10);
    }

    .cta-title {
      margin: 0 0 7px;

      color: #1e3a8a;

      font-size: 15px;

      font-weight: 800;
    }

    .cta-text {
      max-width: 400px;

      margin: 0 auto;

      color: #64748b;

      font-size: 12px;

      line-height: 1.75;
    }

    /* =========================
       DIVIDER
    ========================== */

    .divider {
      height: 1px;

      margin: 32px 0 24px;

      background: #e5e7eb;
    }

    /* =========================
       FOOTER
    ========================== */

    .footer {
      padding: 0 40px 35px;

      text-align: center;
    }

    .footer-brand {
      margin: 0 0 7px;

      color: #1d4ed8;

      font-size: 16px;

      font-weight: 800;
    }

    .footer-tagline {
      margin: 0 0 8px;

      color: #64748b;

      font-size: 11px;

      font-weight: 500;
    }

    .footer-text {
      margin: 0;

      color: #94a3b8;

      font-size: 11px;

      line-height: 1.7;
    }

    .footer-links {
      margin-top: 12px;

      font-size: 11px;
    }

    .footer-links a {
      color: #2563eb;

      text-decoration: none;
    }

    /* =========================
       MOBILE
    ========================== */

    @media only screen and (max-width: 600px) {

      .email-wrapper {
        padding: 20px 10px;
      }

      .hero {
        padding: 36px 25px 47px;
      }

      .content {
        padding: 30px 22px;
      }

      .footer {
        padding: 0 22px 30px;
      }

      .hero-title {
        font-size: 25px;
      }

      .hero-subtitle {
        font-size: 13px;
      }

      .icon-wrapper {
        width: 76px;
        height: 76px;
      }

      .university-icon {
        width: 62px;
        height: 62px;

        font-size: 28px;

        line-height: 62px;
      }

      .otp {
        font-size: 27px;

        letter-spacing: 7px;

        padding: 14px 21px;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
    >
      <tr>
        <td align="center">

          <table
            role="presentation"
            class="email-container"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
          >

            <!-- =========================
                 HERO
            ========================== -->

            <tr>
              <td class="hero">

                <div class="icon-wrapper">

                  <div class="university-icon">
                    🎓
                  </div>

                </div>

                <h1 class="hero-title">
                  Reset Your Password
                </h1>

                <p class="hero-subtitle">
                  Secure your CloudVarsity account
                  and get back to your university experience.
                </p>

              </td>
            </tr>


            <!-- =========================
                 CONTENT
            ========================== -->

            <tr>
              <td class="content">

                <p class="greeting">
                  Hello <%= name %> 👋
                </p>

                <p class="description">
                  We received a request to reset the password
                  for your <strong>CloudVarsity</strong> account.
                  Use the secure verification code below to
                  continue.
                </p>


                <!-- =========================
                     OTP
                ========================== -->

                <div class="otp-section">

                  <p class="otp-label">
                    Your Verification Code
                  </p>

                  <div class="otp">
                    <%= otp %>
                  </div>

                  <p class="expiration">
                    This code will expire in
                    <strong>
                      <%= expirationMinutes %> minutes
                    </strong>.
                  </p>

                </div>


                <!-- =========================
                     STEPS
                ========================== -->

                <div class="steps-card">

                  <p class="steps-title">
                    How to reset your password
                  </p>

                  <div class="step">

                    <div class="step-number">
                      <span>1</span>
                    </div>

                    <div class="step-text">
                      Return to the CloudVarsity
                      password reset page.
                    </div>

                  </div>

                  <div class="step">

                    <div class="step-number">
                      <span>2</span>
                    </div>

                    <div class="step-text">
                      Enter the verification code
                      provided in this email.
                    </div>

                  </div>

                  <div class="step">

                    <div class="step-number">
                      <span>3</span>
                    </div>

                    <div class="step-text">
                      Create a new password and securely
                      access your university account again.
                    </div>

                  </div>

                </div>


                <!-- =========================
                     SECURITY NOTICE
                ========================== -->

                <div class="security-box">

                  <div class="security-icon">
                    🛡️
                  </div>

                  <div class="security-text">
                    <strong>Keep your verification code private.</strong>
                    Never share this OTP with anyone.
                    CloudVarsity will never ask you for your
                    verification code by phone, email, or message.
                  </div>

                </div>


                <!-- =========================
                     UNIVERSITY MESSAGE
                ========================== -->

                <div class="cta-section">

                  <p class="cta-title">
                    Your academic journey continues 🎓
                  </p>

                  <p class="cta-text">
                    Once your password is reset, you can return
                    to your CloudVarsity account and access your
                    courses, academic information, schedules,
                    and university resources.
                  </p>

                </div>


                <div class="divider"></div>

                <p class="description">
                  If you did not request a password reset,
                  you can safely ignore this email.
                  Your password will remain unchanged.
                </p>

              </td>
            </tr>


            <!-- =========================
                 FOOTER
            ========================== -->

            <tr>
              <td class="footer">

                <p class="footer-brand">
                  CloudVarsity
                </p>

                <p class="footer-tagline">
                  Empowering Digital University Education.
                </p>

                <p class="footer-text">
                  &copy; <%= new Date().getFullYear() %>
                  CloudVarsity.
                  All rights reserved.
                </p>

                <div class="footer-links">

                  <a href="#">
                    Privacy Policy
                  </a>

                  &nbsp;&nbsp;•&nbsp;&nbsp;

                  <a href="#">
                    Help &amp; Support
                  </a>

                </div>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </div>

</body>
</html>
