<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Course Registration Confirmed - CloudVarsity</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0;
      background: #f3f6fb;
      color: #1e293b;
      font-family: "Inter", Arial, Helvetica, sans-serif;
    }
    table { border-spacing: 0; }
    .email-wrapper {
      width: 100%; padding: 45px 15px;
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.15), transparent 34%),
        radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.14), transparent 34%),
        #f3f6fb;
    }
    .email-container {
      width: 100%; max-width: 620px; margin: 0 auto; overflow: hidden;
      background: #ffffff; border-radius: 24px;
      box-shadow: 0 25px 65px rgba(15, 23, 42, 0.11), 0 8px 24px rgba(37, 99, 235, 0.07);
    }
    .hero {
      position: relative; overflow: hidden;
      padding: 46px 40px 56px; text-align: center;
      background:
        radial-gradient(circle at 8% 12%, rgba(255, 255, 255, 0.24), transparent 25%),
        radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.13), transparent 30%),
        linear-gradient(135deg, #1d4ed8 0%, #2563eb 45%, #7c3aed 100%);
    }
    .hero::before {
      content: ""; position: absolute; width: 170px; height: 170px;
      left: -85px; bottom: -85px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.07);
    }
    .hero::after {
      content: ""; position: absolute; width: 210px; height: 210px;
      right: -105px; top: -105px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }
    .icon-wrapper {
      position: relative; z-index: 2; width: 86px; height: 86px;
      margin: 0 auto 22px; padding: 7px; border-radius: 22px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.28);
      box-shadow: 0 15px 34px rgba(0, 0, 0, 0.13);
    }
    .hero-icon {
      width: 72px; height: 72px; border-radius: 17px;
      background: #ffffff; color: #1d4ed8; font-size: 32px;
      line-height: 72px; text-align: center;
    }
    .hero-title {
      position: relative; z-index: 2; margin: 0; color: #ffffff;
      font-size: 29px; line-height: 1.3; font-weight: 800; letter-spacing: -0.6px;
    }
    .hero-subtitle {
      position: relative; z-index: 2; max-width: 455px; margin: 14px auto 0;
      color: rgba(255, 255, 255, 0.88); font-size: 14px; line-height: 1.75;
    }
    .content { padding: 40px; }
    .greeting { margin: 0 0 10px; color: #111827; font-size: 18px; font-weight: 700; }
    .description { margin: 0; color: #64748b; font-size: 14px; line-height: 1.85; }
    .info-card {
      margin: 30px 0; padding: 24px; border-radius: 19px;
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.07), rgba(124, 58, 237, 0.08));
      border: 1px solid rgba(59, 130, 246, 0.13);
    }
    .info-card.success {
      background: linear-gradient(135deg, #f0fdf4, #eff6ff);
      border: 1px solid #bbf7d0;
    }
    .info-card.warning {
      background: linear-gradient(135deg, #fff7ed, #fef2f2);
      border: 1px solid #fed7aa;
    }
    .info-title { margin: 0 0 14px; color: #1e293b; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
    .info-row { display: table; width: 100%; margin-bottom: 10px; }
    .info-row:last-child { margin-bottom: 0; }
    .info-label { display: table-cell; color: #64748b; font-size: 13px; font-weight: 600; padding-right: 10px; }
    .info-value { display: table-cell; color: #1e293b; font-size: 13px; font-weight: 700; text-align: right; }
    .status-card {
      margin-top: 25px; padding: 20px; border-radius: 15px;
      background: #f8fafc; border: 1px solid #e2e8f0;
    }
    .cta-section {
      margin-top: 28px; padding: 26px 20px; text-align: center; border-radius: 18px;
      background: linear-gradient(135deg, #eff6ff, #f5f3ff);
      border: 1px solid rgba(59, 130, 246, 0.10);
    }
    .cta-title { margin: 0 0 7px; color: #1e3a8a; font-size: 15px; font-weight: 800; }
    .cta-text { max-width: 400px; margin: 0 auto; color: #64748b; font-size: 12px; line-height: 1.75; }
    .cta-button {
      display: inline-block; margin-top: 16px; padding: 13px 29px; border-radius: 10px;
      background: linear-gradient(135deg, #1d4ed8, #2563eb 50%, #7c3aed);
      color: #ffffff !important; font-size: 12px; font-weight: 700; text-decoration: none;
      box-shadow: 0 9px 23px rgba(37, 99, 235, 0.22);
    }
    .security-box {
      display: table; width: 100%; margin-top: 25px; padding: 18px; border-radius: 14px;
      background: #eff6ff; border: 1px solid #bfdbfe;
    }
    .security-icon { display: table-cell; width: 35px; vertical-align: top; font-size: 18px; }
    .security-text { display: table-cell; vertical-align: top; color: #1e40af; font-size: 12px; line-height: 1.75; }
    .divider { height: 1px; margin: 32px 0 24px; background: #e5e7eb; }
    .footer { padding: 0 40px 35px; text-align: center; }
    .footer-brand { margin: 0 0 7px; color: #1d4ed8; font-size: 16px; font-weight: 800; }
    .footer-tagline { margin: 0 0 8px; color: #64748b; font-size: 11px; font-weight: 500; }
    .footer-text { margin: 0; color: #94a3b8; font-size: 11px; line-height: 1.7; }
    .footer-links { margin-top: 12px; font-size: 11px; }
    .footer-links a { color: #2563eb; text-decoration: none; }
    @media only screen and (max-width: 600px) {
      .email-wrapper { padding: 20px 10px; }
      .hero { padding: 36px 25px 47px; }
      .content { padding: 30px 22px; }
      .footer { padding: 0 22px 30px; }
      .hero-title { font-size: 25px; }
      .hero-subtitle { font-size: 13px; }
      .icon-wrapper { width: 76px; height: 76px; }
      .hero-icon { width: 62px; height: 62px; font-size: 28px; line-height: 62px; }
    }
</style>
</head>
<body>
  <div class="email-wrapper">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <table role="presentation" class="email-container" width="620" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td class="hero">
                <div class="icon-wrapper"><div class="hero-icon">📚</div></div>
                <h1 class="hero-title">Course Registration Confirmed</h1>
                <p class="hero-subtitle">You're all set for this course — see the details below.</p>
              </td>
            </tr>
            <tr>
              <td class="content">

                <p class="greeting">Hello <%= name %> 👋</p>
                <p class="description">
                  You have successfully registered for a course on <strong>CloudVarsity</strong>.
                  Here are the details of your registration.
                </p>

                <div class="info-card success">
                  <p class="info-title">Registration Details</p>
                  <div class="info-row">
                    <div class="info-label">Course</div>
                    <div class="info-value"><%= courseTitle %> (<%= courseCode %>)</div>
                  </div>
                  <div class="info-row">
                    <div class="info-label">Section</div>
                    <div class="info-value"><%= sectionName %></div>
                  </div>
                  <div class="info-row">
                    <div class="info-label">Semester</div>
                    <div class="info-value"><%= semesterName %></div>
                  </div>
                  <div class="info-row">
                    <div class="info-label">Credit Hours</div>
                    <div class="info-value"><%= creditHours %></div>
                  </div>
                </div>

                <div class="cta-section">
                  <p class="cta-title">See your full schedule 📚</p>
                  <p class="cta-text">
                    Log in to CloudVarsity to view all your registered courses, class sections,
                    and upcoming exams in one place.
                  </p>
                </div>

                <div class="divider"></div>

                <p class="description">
                  Changed your mind? You can drop this course from your dashboard before the
                  semester ends, subject to your university's add/drop policy.
                </p>

              </td>
            </tr>
            <tr>
              <td class="footer">
                <p class="footer-brand">CloudVarsity</p>
                <p class="footer-tagline">Empowering Digital University Education.</p>
                <p class="footer-text">&copy; <%= new Date().getFullYear() %> CloudVarsity. All rights reserved.</p>
                <div class="footer-links">
                  <a href="#">Privacy Policy</a>&nbsp;&nbsp;&bull;&nbsp;&nbsp;<a href="#">Help &amp; Support</a>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
