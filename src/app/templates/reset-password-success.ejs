
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Password Reset Successful - CloudVarsity</title>

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;

      background: #f3f6fb;

      color: #1e293b;

      font-family:
        "Inter",
        Arial,
        Helvetica,
        sans-serif;
    }

    table {
      border-spacing: 0;
    }

    .email-wrapper {
      width: 100%;
      padding: 45px 15px;

      background:
        radial-gradient(
          circle at top left,
          rgba(37, 99, 235, 0.15),
          transparent 34%
        ),
        radial-gradient(
          circle at bottom right,
          rgba(124, 58, 237, 0.14),
          transparent 34%
        ),
        #f3f6fb;
    }

    .email-container {
      width: 100%;
      max-width: 620px;

      margin: 0 auto;
      overflow: hidden;

      background: #ffffff;

      border-radius: 24px;

      box-shadow:
        0 25px 65px rgba(15, 23, 42, 0.11),
        0 8px 24px rgba(37, 99, 235, 0.07);
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      position: relative;
      overflow: hidden;

      padding: 48px 40px 58px;

      text-align: center;

      background:
        radial-gradient(
          circle at 8% 12%,
          rgba(255, 255, 255, 0.24),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 80%,
          rgba(255, 255, 255, 0.13),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #1d4ed8 0%,
          #2563eb 45%,
          #7c3aed 100%
        );
    }

    .hero::before {
      content: "";

      position: absolute;

      width: 170px;
      height: 170px;

      left: -85px;
      bottom: -85px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.07);
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 210px;
      height: 210px;

      right: -105px;
      top: -105px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.08);
    }

    /* =========================
       SUCCESS ICON
    ========================== */

    .icon-wrapper {
      position: relative;
      z-index: 2;

      width: 88px;
      height: 88px;

      margin: 0 auto 22px;

      padding: 7px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.17);

      border: 1px solid rgba(255, 255, 255, 0.30);

      box-shadow:
        0 15px 35px rgba(0, 0, 0, 0.13);
    }

    .success-icon {
      width: 74px;
      height: 74px;

      border-radius: 50%;

      background: #ffffff;

      color: #16a34a;

      font-size: 37px;
      font-weight: 800;

      line-height: 74px;

      text-align: center;
    }

    /* =========================
       HERO TEXT
    ========================== */

    .hero-title {
      position: relative;
      z-index: 2;

      margin: 0;

      color: #ffffff;

      font-size: 29px;

      line-height: 1.3;

      font-weight: 800;

      letter-spacing: -0.6px;
    }

    .hero-subtitle {
      position: relative;
      z-index: 2;

      max-width: 450px;

      margin: 14px auto 0;

      color: rgba(255, 255, 255, 0.88);

      font-size: 14px;

      line-height: 1.75;
    }

    /* =========================
       CONTENT
    ========================== */

    .content {
      padding: 40px;
    }

    .greeting {
      margin: 0 0 10px;

      color: #111827;

      font-size: 18px;

      font-weight: 700;
    }

    .description {
      margin: 0;

      color: #64748b;

      font-size: 14px;

      line-height: 1.85;
    }

    /* =========================
       SUCCESS CARD
    ========================== */

    .success-card {
      position: relative;

      margin: 30px 0;

      padding: 26px;

      overflow: hidden;

      border-radius: 19px;

      background:
        linear-gradient(
          135deg,
          #f0fdf4,
          #eff6ff
        );

      border: 1px solid #bbf7d0;
    }

    .success-card::after {
      content: "";

      position: absolute;

      width: 130px;
      height: 130px;

      right: -65px;
      top: -65px;

      border-radius: 50%;

      background: rgba(34, 197, 94, 0.07);
    }

    .success-header {
      position: relative;
      z-index: 2;

      display: table;

      width: 100%;
    }

    .success-small-icon {
      display: table-cell;

      width: 48px;

      vertical-align: top;
    }

    .success-small-icon span {
      display: inline-block;

      width: 38px;
      height: 38px;

      border-radius: 11px;

      background: #dcfce7;

      color: #15803d;

      font-size: 19px;

      font-weight: 800;

      line-height: 38px;

      text-align: center;
    }

    .success-content {
      display: table-cell;

      vertical-align: top;
    }

    .success-title {
      margin: 0 0 5px;

      color: #166534;

      font-size: 16px;

      font-weight: 800;
    }

    .success-text {
      margin: 0;

      color: #64748b;

      font-size: 12px;

      line-height: 1.75;
    }

    /* =========================
       ACCOUNT STATUS
    ========================== */

    .status-card {
      margin-top: 25px;

      padding: 20px;

      border-radius: 15px;

      background: #f8fafc;

      border: 1px solid #e2e8f0;
    }

    .status-label {
      margin: 0 0 8px;

      color: #94a3b8;

      font-size: 10px;

      font-weight: 800;

      text-transform: uppercase;

      letter-spacing: 1.4px;
    }

    .status-row {
      display: table;

      width: 100%;
    }

    .status-icon {
      display: table-cell;

      width: 34px;

      vertical-align: middle;

      font-size: 18px;
    }

    .status-text {
      display: table-cell;

      vertical-align: middle;

      color: #334155;

      font-size: 13px;

      font-weight: 600;
    }

    .status-badge {
      display: table-cell;

      width: 1%;

      white-space: nowrap;

      vertical-align: middle;

      text-align: right;
    }

    .badge {
      display: inline-block;

      padding: 6px 11px;

      border-radius: 20px;

      background: #dcfce7;

      color: #15803d;

      font-size: 10px;

      font-weight: 800;
    }

    /* =========================
       CTA
    ========================== */

    .cta-section {
      margin-top: 28px;

      padding: 28px 20px;

      text-align: center;

      border-radius: 19px;

      background:
        linear-gradient(
          135deg,
          #eff6ff,
          #f5f3ff
        );

      border: 1px solid rgba(59, 130, 246, 0.10);
    }

    .cta-title {
      margin: 0 0 8px;

      color: #1e3a8a;

      font-size: 16px;

      font-weight: 800;
    }

    .cta-text {
      max-width: 400px;

      margin: 0 auto 19px;

      color: #64748b;

      font-size: 12px;

      line-height: 1.75;
    }

    .cta-button {
      display: inline-block;

      padding: 13px 29px;

      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          #1d4ed8,
          #2563eb 50%,
          #7c3aed
        );

      color: #ffffff !important;

      font-size: 12px;

      font-weight: 700;

      text-decoration: none;

      box-shadow:
        0 9px 23px rgba(37, 99, 235, 0.22);
    }

    /* =========================
       SECURITY NOTICE
    ========================== */

    .security-box {
      display: table;

      width: 100%;

      margin-top: 25px;

      padding: 19px;

      border-radius: 15px;

      background: #fff7ed;

      border: 1px solid #fed7aa;
    }

    .security-icon {
      display: table-cell;

      width: 35px;

      vertical-align: top;

      font-size: 18px;
    }

    .security-text {
      display: table-cell;

      vertical-align: top;

      color: #9a3412;

      font-size: 12px;

      line-height: 1.75;
    }

    /* =========================
       DIVIDER
    ========================== */

    .divider {
      height: 1px;

      margin: 32px 0 24px;

      background: #e5e7eb;
    }

    /* =========================
       FOOTER
    ========================== */

    .footer {
      padding: 0 40px 35px;

      text-align: center;
    }

    .footer-brand {
      margin: 0 0 7px;

      color: #1d4ed8;

      font-size: 16px;

      font-weight: 800;
    }

    .footer-tagline {
      margin: 0 0 8px;

      color: #64748b;

      font-size: 11px;

      font-weight: 500;
    }

    .footer-text {
      margin: 0;

      color: #94a3b8;

      font-size: 11px;

      line-height: 1.7;
    }

    .footer-links {
      margin-top: 12px;

      font-size: 11px;
    }

    .footer-links a {
      color: #2563eb;

      text-decoration: none;
    }

    /* =========================
       MOBILE
    ========================== */

    @media only screen and (max-width: 600px) {

      .email-wrapper {
        padding: 20px 10px;
      }

      .hero {
        padding: 38px 25px 48px;
      }

      .content {
        padding: 30px 22px;
      }

      .footer {
        padding: 0 22px 30px;
      }

      .hero-title {
        font-size: 25px;
      }

      .hero-subtitle {
        font-size: 13px;
      }

      .icon-wrapper {
        width: 76px;
        height: 76px;
      }

      .success-icon {
        width: 62px;
        height: 62px;

        font-size: 31px;

        line-height: 62px;
      }

      .status-badge {
        display: none;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
    >
      <tr>
        <td align="center">

          <table
            role="presentation"
            class="email-container"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
          >

            <!-- =========================
                 HERO
            ========================== -->

            <tr>
              <td class="hero">

                <div class="icon-wrapper">

                  <div class="success-icon">
                    &#10003;
                  </div>

                </div>

                <h1 class="hero-title">
                  Password Reset Successful
                </h1>

                <p class="hero-subtitle">
                  Your CloudVarsity account is secure
                  and ready for your next university session.
                </p>

              </td>
            </tr>


            <!-- =========================
                 CONTENT
            ========================== -->

            <tr>
              <td class="content">

                <p class="greeting">
                  Hello <%= name %> 👋
                </p>

                <p class="description">
                  Your <strong>CloudVarsity</strong> account
                  password has been changed successfully.
                  Your new password is now active.
                </p>


                <!-- =========================
                     SUCCESS CARD
                ========================== -->

                <div class="success-card">

                  <div class="success-header">

                    <div class="success-small-icon">
                      <span>
                        &#10003;
                      </span>
                    </div>

                    <div class="success-content">

                      <p class="success-title">
                        Password Updated Successfully
                      </p>

                      <p class="success-text">
                        You can now use your new password
                        to securely sign in to your CloudVarsity
                        university account.
                      </p>

                    </div>

                  </div>

                </div>


                <!-- =========================
                     ACCOUNT STATUS
                ========================== -->

                <div class="status-card">

                  <p class="status-label">
                    Account Security
                  </p>

                  <div class="status-row">

                    <div class="status-icon">
                      🔐
                    </div>

                    <div class="status-text">
                      Your account password has been updated.
                    </div>

                    <div class="status-badge">
                      <span class="badge">
                        SECURE
                      </span>
                    </div>

                  </div>

                </div>


                <!-- =========================
                     CTA
                ========================== -->

                <div class="cta-section">

                  <p class="cta-title">
                    Ready to continue your university journey? 🎓
                  </p>

                  <p class="cta-text">
                    Sign in to CloudVarsity and access your
                    courses, academic information, schedules,
                    results, and other university resources.
                  </p>

                  <a
                    href="#"
                    class="cta-button"
                  >
                    Go to CloudVarsity →
                  </a>

                </div>


                <!-- =========================
                     SECURITY NOTICE
                ========================== -->

                <div class="security-box">

                  <div class="security-icon">
                    🛡️
                  </div>

                  <div class="security-text">
                    <strong>Didn't change your password?</strong>
                    If you did not make this change, please
                    contact CloudVarsity support immediately
                    to help secure your account.
                  </div>

                </div>


                <div class="divider"></div>

                <p class="description">
                  For better security, use a strong and unique
                  password and never share your login credentials
                  with anyone.
                </p>

              </td>
            </tr>


            <!-- =========================
                 FOOTER
            ========================== -->

            <tr>
              <td class="footer">

                <p class="footer-brand">
                  CloudVarsity
                </p>

                <p class="footer-tagline">
                  Empowering Digital University Education.
                </p>

                <p class="footer-text">
                  &copy; <%= new Date().getFullYear() %>
                  CloudVarsity.
                  All rights reserved.
                </p>

                <div class="footer-links">

                  <a href="#">
                    Privacy Policy
                  </a>

                  &nbsp;&nbsp;•&nbsp;&nbsp;

                  <a href="#">
                    Help &amp; Support
                  </a>

                </div>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </div>

</body>
</html>
