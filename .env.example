# Backend API base URL including /api/v1 (required, server-only).
# The browser calls /api/v1 on this site; next.config.ts rewrites it here.
API_URL=http://localhost:5000/api/v1

# Public URL of this frontend; used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Identity Services OAuth client ID. When set, a "Sign in with Google"
# button appears on the login page. Optional — leave empty to disable it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shows the one-click demo login buttons on /login. The buttons contain no
# credentials; they only work when the backend's DEMO_MODE is also "true".
NEXT_PUBLIC_DEMO_MODE=false
